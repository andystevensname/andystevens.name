<div id="animation">
  <div id="animation-canvas"></div>
</div>

<style>
#animation {
  height: 100vh;
  position: relative;
  overflow: visible;
}

#animation-canvas {
  width: 100%;
  height: 100%;
  position: relative;
  overflow: visible;
}

/* The render SVG is created in JS and appended here; :global() targets it
   since dynamically-created elements don't carry the scoped-style hash. */
#animation-canvas :global(svg) {
  display: block;
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  overflow: visible;
}
</style>

<script>
type AnimationLib = typeof import('../lib/animation/index.js');

const animationCanvas = document.getElementById('animation-canvas');

if (animationCanvas) {
  // #site-sidebar — the only thing that ever shows this animation — is
  // `display: none` below 816px (see global.css). Below that breakpoint the
  // canvas has zero size and nothing is ever painted, yet the old code still
  // fetched the animation chunk, built ~20 SVG nodes and ran a permanent
  // requestAnimationFrame loop on every phone that loaded any page.
  //
  // Gate on the same breakpoint, and treat it as live state rather than a
  // one-time check: widening the viewport starts the animation, narrowing it
  // tears the whole thing down. No reload either way.
  const desktop = window.matchMedia('(min-width: 816px)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  let libPromise: Promise<AnimationLib> | null = null;
  let running: { resize(): void; destroy(): void } | null = null;
  let starting = false;

  function mount(lib: AnimationLib) {
    const { svgEl, SVG_NS, createBeams, createPoetry, createGears } = lib;
    const canvas = animationCanvas!;

    const svg = document.createElementNS(SVG_NS, 'svg') as SVGSVGElement;
    canvas.appendChild(svg);

    const reduced = reducedMotion.matches;

    let beams: ReturnType<typeof createBeams>;
    let poetry: ReturnType<typeof createPoetry>;
    let gears: ReturnType<typeof createGears>;
    let background: SVGGElement;
    let thingsGroup: SVGGElement;
    let poetryGroup: SVGGElement;
    let gadgetsGroup: SVGGElement;
    let cycleStart: number | null = null;
    let lastFramePos = -1;
    let frameId: number | null = null;

    function setup() {
      // Cancel previous run's Web Animations and destroy controllers so
      // their effect targets and captured closures become GC-eligible.
      // Without this, resize events leak a set of Web Animations + their
      // group element targets + child polygons on every invocation.
      svg.getAnimations({ subtree: true }).forEach((a) => a.cancel());
      beams?.destroy();
      poetry?.destroy();
      gears?.destroy();

      // Clear previous content
      while (svg.firstChild) svg.removeChild(svg.firstChild);

      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      svg.setAttribute('viewBox', `0 0 ${w} ${h}`);

      background = svgEl<SVGGElement>('g');
      svg.appendChild(background);

      gadgetsGroup = svgEl<SVGGElement>('g');
      thingsGroup = svgEl<SVGGElement>('g');
      poetryGroup = svgEl<SVGGElement>('g');
      background.append(gadgetsGroup, thingsGroup, poetryGroup);

      beams = createBeams(thingsGroup, h, w);
      // Viewport height is measured here rather than inside the animation
      // loop, where reading it every third frame risked forcing layout.
      poetry = createPoetry(poetryGroup, w, document.documentElement.clientHeight);
      gears = createGears(svg, gadgetsGroup, w);

      if (!reduced) {
        // Hide delayed phases before their Web Animations enter active phase.
        // Inner elements have non-zero native opacity (bars 0.75, gears 0.7),
        // so during the animation's "before" phase with fill:none they'd leak
        // through. Explicit group opacity:0 keeps them hidden until the
        // animation takes over.
        poetryGroup.style.opacity = '0';
        gadgetsGroup.style.opacity = '0';

        // Phase sequencing via Web Animations API (survives view transitions)
        const phaseKeyframes = [
          { opacity: 0, offset: 0 },
          { opacity: 1, offset: 0.04 },
          { opacity: 1, offset: 0.293 },
          { opacity: 0, offset: 0.333 },
          { opacity: 0, offset: 1 },
        ];
        const phaseTiming = { duration: 12500, iterations: Infinity };
        thingsGroup.animate(phaseKeyframes, { ...phaseTiming, delay: 0 });
        poetryGroup.animate(phaseKeyframes, { ...phaseTiming, delay: 4170 });
        gadgetsGroup.animate(phaseKeyframes, { ...phaseTiming, delay: 8330 });
      }

      // Re-sync the wall-clock cycle on resize so the new layout's
      // first tick starts at cycle position 0.
      cycleStart = null;
      lastFramePos = -1;
    }

    // JS tick handles per-element randomized animations (beam movement,
    // bar vertex jitter). Phase opacity transitions are handled by the
    // Web Animations API above; gear rotation is a Web Animation too, so
    // this loop no longer touches the gears at all beyond building them once.
    //
    // Phase position is derived from wall-clock time, NOT from a
    // per-rAF counter, so that the JS tick stays in lockstep with the
    // Web Animations regardless of display refresh rate. On a 120Hz
    // display, a naive frame counter would complete a 750-frame cycle
    // in ~6.25s while the Web Animations take 12.5s, and the two clocks
    // would drift continuously — bars would jitter while invisible and
    // beams would freeze ~2s before their fade-out.
    const cycleDuration = 12500;
    const totalFrames = 750;

    function tick(now: number) {
      if (cycleStart === null) cycleStart = now;
      const elapsed = (now - cycleStart) % cycleDuration;
      const framePos = Math.floor((elapsed / cycleDuration) * totalFrames);

      // High-refresh displays fire rAF faster than framePos advances;
      // skip duplicate calls so throttles inside animate() stay meaningful.
      if (framePos !== lastFramePos) {
        beams.animate(framePos, 0, 249);
        poetry.animate(framePos, 250, 499);
        gears.animate(framePos, 500, 749);
        lastFramePos = framePos;
      }

      frameId = requestAnimationFrame(tick);
    }

    setup();

    if (!reduced) frameId = requestAnimationFrame(tick);

    return {
      resize: setup,
      destroy() {
        if (frameId !== null) {
          cancelAnimationFrame(frameId);
          frameId = null;
        }
        svg.getAnimations({ subtree: true }).forEach((a) => a.cancel());
        beams?.destroy();
        poetry?.destroy();
        gears?.destroy();
        svg.remove();
      },
    };
  }

  async function start() {
    if (running || starting || !desktop.matches) return;
    starting = true;
    try {
      const lib = await (libPromise ??= import('../lib/animation/index.js'));
      // The viewport can narrow while the chunk is in flight; re-check
      // rather than mounting into a container that's since been hidden.
      if (desktop.matches && !running) running = mount(lib);
    } finally {
      starting = false;
    }
  }

  function stop() {
    running?.destroy();
    running = null;
  }

  // Defer the animation bundle until the browser is idle so its bytes
  // don't count against LCP / critical-path JS in Lighthouse. The chunk
  // is already a dynamic import, but fetching it during initial load
  // still shows up as unused JS until the animation actually runs.
  function startWhenIdle() {
    const kick = () => requestAnimationFrame(() => requestAnimationFrame(start));
    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(kick, { timeout: 2000 });
    } else {
      setTimeout(kick, 200);
    }
  }

  let resizeTimer: ReturnType<typeof setTimeout>;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => running?.resize(), 150);
  });

  desktop.addEventListener('change', (event) => {
    if (event.matches) startWhenIdle();
    else stop();
  });

  // Toggling the OS reduced-motion setting rebuilds with the other timing
  // model, again without a reload.
  reducedMotion.addEventListener('change', () => {
    if (!running) return;
    stop();
    startWhenIdle();
  });

  if (desktop.matches) startWhenIdle();
}
</script>
