---
interface Props {
  type: 'article' | 'note' | 'bookmark' | 'like' | 'photo' | 'reply' | 'writing' | 'award' | 'album' | 'code';
  url: string;
  date: Date;
  title?: string;
  summary?: string;
  bodyHtml?: string;
  quote?: string;
  linkTo?: string;
  photo?: string;
  photoWidth?: number;
  photoHeight?: number;
  alt?: string;
  venue?: string;
  category?: string;
  eager?: boolean;
  priority?: boolean;
}

import { formatDate } from '../lib/date';
import iconsUrl from '../assets/icons.svg?url';

const { type, url, date, title, summary, bodyHtml, quote, linkTo, photo, photoWidth, photoHeight, alt, venue, category, eager, priority } = Astro.props;
const imgLoading = eager ? 'eager' : 'lazy';
const imgFetchPriority = priority ? 'high' : undefined;

// Accessible name for the date permalink below. Its visible text is only the
// date, so any two posts published on the same day produced two links with
// identical accessible names pointing at different posts — axe
// `identical-links-same-purpose` (WCAG 2.4.9). Appending hidden text rather
// than setting aria-label keeps the visible date part of the accessible name,
// which aria-label alone would violate (WCAG 2.5.3, Label in Name).
const stripHtml = (value: string) => value.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
const truncate = (value: string, max = 60) =>
  value.length > max ? `${value.slice(0, max).trimEnd()}\u2026` : value;

// Not every type carries a title — notes have only a body, replies only a
// target — so fall back through whatever identifies the entry, and finally to
// the type name so the label is never empty.
const permalinkLabel = truncate(
  [title, summary, quote, alt, bodyHtml, linkTo]
    .map((candidate) => (candidate ? stripHtml(candidate) : ''))
    .find((candidate) => candidate.length > 0) ?? type
);
---

<article class="h-entry" data-type={type} data-category={category ?? type}>
  <a href={url}><time datetime={date.toISOString()}>{formatDate(date)}</time><span class="sr-only">{`, ${permalinkLabel}`}</span></a>
  <div>
    <div class="feed-icon"><svg class="icon" width="20" height="20" aria-hidden="true"><use href={`${iconsUrl}#icon-${type}`}/></svg></div>
    {type === 'article' && (<>
      <p dir="auto"><a class="p-name u-url" href={url}>{title}</a></p>
      {quote && <p dir="auto">{quote} <a href={url} aria-label={`Read ${title}`}><svg class="icon" width="20" height="20" aria-hidden="true"><use href={`${iconsUrl}#icon-readmore`}/></svg></a></p>}
    </>)}
    {type === 'note' && bodyHtml && (
      <div class="e-content post-body" dir="auto" set:html={bodyHtml} />
    )}
    {type === 'bookmark' && (<>
      <p><a href={linkTo}>{title ?? linkTo}</a></p>
      {bodyHtml && <div class="e-content post-body" dir="auto" set:html={bodyHtml} />}
    </>)}
    {type === 'like' && (<>
      <p><a href={linkTo}>{title ?? linkTo}</a></p>
      {summary && <p dir="auto">{summary}</p>}
    </>)}
    {type === 'photo' && (<>
      {photo && <a href={url}><img class="u-photo" src={`${photo}?class=photo400`} srcset={`${photo}?class=photo200 200w, ${photo}?class=photo400 400w, ${photo}?class=photo800 800w, ${photo}?class=photo1600 1600w`} sizes="(min-width: 640px) 40rem, 100vw" width={photoWidth} height={photoHeight} alt={alt ?? title ?? ''} loading={imgLoading} fetchpriority={imgFetchPriority} decoding="async" /></a>}
      {title && <p dir="auto">{title}</p>}
    </>)}
    {type === 'reply' && (<>
      <p>Replied to <a href={linkTo}>{linkTo}</a></p>
      {bodyHtml && <div class="e-content post-body" dir="auto" set:html={bodyHtml} />}
    </>)}
    {type === 'writing' && (<>
      <p dir="auto">{linkTo ? <a href={linkTo}>{title}</a> : title}</p>
      {(venue || category) && <p>{[venue, category ? category.charAt(0).toUpperCase() + category.slice(1) : ''].filter(Boolean).join(' — ')}</p>}
      {bodyHtml && <div class="e-content post-body" dir="auto" set:html={bodyHtml} />}
    </>)}
    {type === 'award' && (<>
      <p dir="auto">{title}</p>
      {venue && <p>{venue}</p>}
    </>)}
    {type === 'album' && (<>
      <p dir="auto"><a href={url}>{title}</a></p>
      {photo && <a href={url}><img class="u-photo" src={`${photo}?class=photo400`} srcset={`${photo}?class=photo200 200w, ${photo}?class=photo400 400w, ${photo}?class=photo800 800w, ${photo}?class=photo1600 1600w`} sizes="(min-width: 640px) 40rem, 100vw" width={photoWidth} height={photoHeight} alt={title ?? ''} loading={imgLoading} fetchpriority={imgFetchPriority} decoding="async" /></a>}
      {summary && <p dir="auto">{summary}</p>}
    </>)}
    {type === 'code' && (<>
      <p dir="auto"><a class="p-name u-url" href={url}>{title}</a></p>
      {summary && <p dir="auto">{summary}</p>}
    </>)}
  </div>
</article>
